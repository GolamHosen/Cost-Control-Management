# Supabase PostgreSQL: in Dashboard > Connect, copy the complete Session pooler
# URI. Do not assemble the hostname manually; it contains the project region.
SUPABASE_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Temporary migration fallback only: if an existing URL still uses the direct
# db.<project-ref>.supabase.co endpoint, specify its Session pooler hostname.
# Prefer replacing SUPABASE_DATABASE_URL with the complete URI from Connect.
# SUPABASE_POOLER_HOST="aws-0-[region].pooler.supabase.com"

# Optional: maximum number of PostgreSQL connections used by this application.
SUPABASE_POOL_MAX=5

# Turso: all project data (projects, memberships, sheets, rows, and cells).
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Use a unique, high-entropy value in every environment.
AUTH_SECRET="replace-with-a-long-random-secret"
